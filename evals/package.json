{
  "name": "@dltech/atlas-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run src/build.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "ATLAS_TESTING=1 bun test",
    "eval:run": "bun run src/build.ts && bun run src/cli.ts run",
    "eval:validate": "bun run src/cli.ts validate",
    "eval:export-examples": "bun run src/cli.ts export-examples",
    "eval:curate": "bun run src/cli.ts curate",
    "eval:label-review": "bun run src/cli.ts label-review",
    "eval:compare": "bun run src/cli.ts compare"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "26.3.0",
    "@dltech/atlas-core": "workspace:*",
    "evalite": "0.19.0",
    "vitest": "4.0.1",
    "vite": "6.4.1",
    "typescript": "6.0.3",
    "zod": "^4.4.3"
  }
}
