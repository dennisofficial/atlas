{
  "name": "@dltech/bun-test-incremental",
  "description": "bun:test preload that reruns only spec files whose recorded inputs changed since they last passed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./preload": {
      "types": "./src/preload.ts",
      "default": "./src/preload.ts"
    }
  },
  "bin": {
    "bun-test-incremental": "./src/bin.ts"
  },
  "dependencies": {
    "es-module-lexer": "^1.7.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
