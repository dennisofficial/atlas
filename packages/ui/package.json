{
  "name": "@dltech/atlas-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/highlighter": "./src/lib/highlighter.tsx"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./ai/*": "./src/ai/*.tsx",
    "./lib/highlighter": "./src/lib/highlighter.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./theme.css": "./src/styles/theme.css",
    "./base.css": "./src/styles/base.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "generate": "bun run tools/generate-css.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@codemirror/language": "^6.13.1",
    "@lezer/highlight": "^1.2.5",
    "@mdxeditor/editor": "^4.3.3",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.45.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.14.6",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.1.18"
  }
}
