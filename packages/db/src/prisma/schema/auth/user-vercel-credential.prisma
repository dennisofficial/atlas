// use prisma-8
model UserVercelCredential {
  userId               String               @id
  kind                 String               @default("token")
  sealedToken          String
  sealedRefreshToken   String?
  accessTokenExpiresAt TimestamptzJsDate(3)?
  teamId               String
  vercelProjectId      String?
  plan                 String?
  planCheckedAt        TimestamptzJsDate(3)?
  vercelUserId         String?
  oauthNeedsReconnect  Boolean              @default(false)
  createdAt            TimestamptzJsDate(3) @default(now())
  updatedAt            TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
