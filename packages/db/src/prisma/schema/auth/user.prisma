// use prisma-8
model User {
  id                       String                      @id
  name                     String
  email                    String
  emailVerified            Boolean                     @default(false)
  image                    String?
  createdAt                TimestamptzJsDate(3)        @default(now())
  updatedAt                TimestamptzJsDate(3)        @onCreate(now()) @onUpdate(now())
  accounts                 Account[]
  agentAccounts            AgentAccount[]
  cloudSandboxes           CloudSandbox[]
  settings                 UserSetting[]
  deviceCodes              DeviceCode[]
  githubConnection         GithubConnection?
  invitations              Invitation[]
  localPodLeases           LocalPodLease[]
  mcpServers               UserMcpServer[]
  members                  Member[]
  memories                 Memory[]
  oauthConnections         OauthConnection[]
  ownedProjects            Project[]                   @relation(name: "Project_owner")
  createdProjects          Project[]                   @relation(name: "Project_createdBy")
  activeAccounts           ActiveAccount[]
  githubSubscriptions      GithubSubscription[]
  githubPrEvents           GithubPrEvent[]
  githubNoticeDismissals   GithubAppNoticeDismissal[]
  githubRepoHooks          GithubRepoHook[]
  updatedWorkspaceSecrets  WorkspaceSecret[]
  updatedVercelCredentials WorkspaceVercelCredential[]
  publishedBundles         PublishedBundle[]
  secrets                  UserSecret[]
  sessions                 Session[]
  sshSigningKey            SshSigningKey?
  threads                  Thread[]
  userFiles                UserFile[]

  @@unique([email], map: "User_email_key")
}
