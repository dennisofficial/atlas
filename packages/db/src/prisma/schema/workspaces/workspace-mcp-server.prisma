// use prisma-8
model WorkspaceMcpServer {
  id             String               @id
  organizationId String
  name           String
  sealedSpec     String
  createdAt      TimestamptzJsDate(3) @default(now())
  updatedAt      TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "WorkspaceMcpServer_organizationId_name_key")

  @@unique([organizationId, name], map: "WorkspaceMcpServer_organizationId_name_key")
}
