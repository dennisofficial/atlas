// use prisma-8

model Member {
  id             String             @id
  role           String
  createdAt      TimestampString(3) @default(now())
  organizationId String
  userId         String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
}
