// use prisma-8

model WorkspaceSetting {
  id             String             @id
  organizationId String
  key            String
  value          String
  createdAt      TimestampString(3) @default(now())
  updatedAt      TimestampString(3) @onCreate(now()) @onUpdate(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "WorkspaceSetting_organizationId_key_key")

  @@index([organizationId, key], map: "WorkspaceSetting_organizationId_key_key", unique: true)
}
