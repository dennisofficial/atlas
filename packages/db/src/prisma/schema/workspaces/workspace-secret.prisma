// use prisma-8

model WorkspaceSecret {
  id             String             @id
  organizationId String
  name           String
  kind           String             @default("secret")
  sealedValue    String
  updatedById    String?
  createdAt      TimestampString(3) @default(now())
  updatedAt      TimestampString(3) @onCreate(now()) @onUpdate(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "WorkspaceSecret_organizationId_name_key")

  @@index([organizationId, name], map: "WorkspaceSecret_organizationId_name_key", unique: true)
}
