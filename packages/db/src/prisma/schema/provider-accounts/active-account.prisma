// use prisma-8
model ActiveAccount {
  userId    String
  provider  String
  accountId String
  createdAt TimestamptzJsDate(3) @default(now())
  updatedAt TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
  account   AgentAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, provider])
}
