// use prisma-8
model AgentAccount {
  id             String               @id
  provider       String
  kind           String
  origin         String
  label          String
  status         String
  email          String?
  subscription   String?
  importedFrom   String?
  sealedSecret   String
  secretVersion  Int                  @default(0)
  createdAt      TimestamptzJsDate(3) @default(now())
  updatedAt      TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  userId         String
  activePointers ActiveAccount[]
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "AgentAccount_userId_provider_idx")

  @@index([userId, provider], map: "AgentAccount_userId_provider_idx")
}
