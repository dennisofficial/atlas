// use prisma-8
model UserFileMount {
  id             String               @id
  userId         String
  grantId        String
  path           String
  sealedContents String
  mode           Int                  @default(384)
  createdAt      TimestamptzJsDate(3) @default(now())
  updatedAt      TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "UserFileMount_userId_path_key")
  grant          UserAccessGrant      @relation(fields: [grantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, path], map: "UserFileMount_userId_path_key")
  @@index([grantId])
}
