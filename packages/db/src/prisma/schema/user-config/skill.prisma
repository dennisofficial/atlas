// use prisma-8
model Skill {
  id          String               @id @onCreate(cuid(2))
  userId      String?
  projectId   String?
  name        String
  description String               @default("")
  createdAt   TimestamptzJsDate(3) @default(now())
  updatedAt   TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "Skill_userId_name_key")
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "Skill_projectId_name_key")
  files       SkillFile[]

  @@unique([userId, name], map: "Skill_userId_name_key")
  @@unique([projectId, name], map: "Skill_projectId_name_key")
  @@check(expression: sql`("userId" IS NULL) <> ("projectId" IS NULL)`, name: "Skill_owner_check")
}
