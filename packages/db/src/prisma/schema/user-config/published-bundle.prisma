// use prisma-8
model PublishedBundle {
  id        String               @id @onCreate(cuid(2))
  userId    String
  version   Int
  pathname  String
  blobUrl   String
  sha256    String
  sizeBytes Int
  manifest  Jsonb
  createdAt TimestamptzJsDate(3) @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "PublishedBundle_userId_version_key")

  @@unique([userId, version], map: "PublishedBundle_userId_version_key")
  @@unique([pathname], map: "PublishedBundle_pathname_key")
}
