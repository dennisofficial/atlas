// use prisma-8
model UserSecret {
  id          String               @id
  name        String
  sealedValue String
  createdAt   TimestamptzJsDate(3) @default(now())
  updatedAt   TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  userId      String
  grantId     String?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "SecretEntry_userId_name_key")
  grant       UserAccessGrant?     @relation(fields: [grantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([userId, name], map: "SecretEntry_userId_name_key")
  @@index([grantId])

  @@map("SecretEntry")
}
