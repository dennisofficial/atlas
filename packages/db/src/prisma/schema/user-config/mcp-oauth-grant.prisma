// use prisma-8
model McpOauthGrant {
  id               String               @id
  serverUrl        String
  status           String               @default("active")
  sealed           String
  generation       Int                  @default(0)
  refreshAttempt   String?
  refreshStartedAt TimestamptzJsDate(3)?
  createdAt        TimestamptzJsDate(3) @default(now())
  updatedAt        TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "McpOauthGrant_userId_serverUrl_key")

  @@unique([userId, serverUrl], map: "McpOauthGrant_userId_serverUrl_key")
}
