// use prisma-8
model UserHarnessSecret {
  id          String               @id
  name        String
  sealedValue String
  createdAt   TimestamptzJsDate(3) @default(now())
  updatedAt   TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "UserHarnessSecret_userId_name_key")

  @@unique([userId, name], map: "UserHarnessSecret_userId_name_key")
}
