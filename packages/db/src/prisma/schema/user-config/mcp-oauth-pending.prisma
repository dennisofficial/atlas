// use prisma-8
model McpOauthPending {
  id        String               @id
  serverUrl String
  sealed    String
  returnTo  String
  returnSurface String @default("web")
  expiresAt TimestamptzJsDate(3)
  createdAt TimestamptzJsDate(3) @default(now())
  mcpServerId String?
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mcpServer McpServer?           @relation(fields: [mcpServerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "McpOauthPending_userId_idx")
  @@index([mcpServerId], map: "McpOauthPending_mcpServerId_idx")
}
