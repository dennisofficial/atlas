// use prisma-8
model McpOauthPending {
  id        String               @id
  serverUrl String
  sealed    String
  returnTo  String
  expiresAt TimestamptzJsDate(3)
  createdAt TimestamptzJsDate(3) @default(now())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "McpOauthPending_userId_idx")
}
