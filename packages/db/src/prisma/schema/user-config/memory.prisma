// use prisma-8
model Memory {
  id          String               @id @onCreate(cuid(2))
  userId      String
  scope       String
  project     String               @default("")
  name        String
  description String
  type        String
  body        String
  revision    Int                  @default(1)
  createdAt   TimestamptzJsDate(3) @default(now())
  updatedAt   TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "Memory_userId_scope_project_name_key")

  @@index([userId, scope, project, name], map: "Memory_userId_scope_project_name_key", unique: true)
  @@index([userId, project], map: "Memory_userId_project_idx")
}
