// use prisma-8
model WorktreeChanges {
  id           String   @id
  sessionId    String
  repo         String
  worktreePath String
  base         String?
  fingerprint  String
  updatedAt    TimestamptzJsDate(3)
  session      Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "V2WorktreeChanges_sessionId_idx")
  files        WorktreeChangedFile[]

  @@index([sessionId, updatedAt], map: "V2WorktreeChanges_sessionId_idx")
}
