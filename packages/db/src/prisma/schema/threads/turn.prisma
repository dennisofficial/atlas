// use prisma-8

model Turn {
  runId            String @id
  threadId         String
  status           String
  providerId       String
  modelId          String
  steps            Int
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int
  cacheWriteTokens Int
  startedAt        String
  endedAt          String
  durationMs       Int
  userId           String
  thread           Thread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "Turn_threadId_startedAt_idx")

  @@index([threadId, startedAt], map: "Turn_threadId_startedAt_idx")
  @@index([userId], map: "Turn_userId_idx")
}
