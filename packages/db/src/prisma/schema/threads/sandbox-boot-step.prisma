// use prisma-8
model SandboxBootStep {
  id       String               @id @onCreate(cuid(2))
  sessionId String
  step     String
  state    String
  error    String?
  gap      String?
  outcome  String?
  at       TimestamptzJsDate(3) @default(now())
  session  Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "SandboxBootStep_sessionId_at_idx")

  @@index([sessionId, at], map: "SandboxBootStep_sessionId_at_idx")
}
