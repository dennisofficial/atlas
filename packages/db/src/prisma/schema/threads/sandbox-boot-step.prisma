// use prisma-8
model SandboxBootStep {
  id       String               @id @onCreate(cuid(2))
  sessionId String
  step     String
  state    String
  error    String?
  gap      String?
  outcome  String?
  repos    Jsonb?
  seq      BigInt               @default(autoincrement())
  at       TimestamptzJsDate(3) @default(now())
  session  Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "SandboxBootStep_sessionId_seq_idx")

  @@index([sessionId, seq], map: "SandboxBootStep_sessionId_seq_idx")
}
