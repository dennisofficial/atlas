// use prisma-8
model ComposerDraft {
  userId        String
  scopeKey      String
  threadId      String?
  text          String
  attachments   String
  updatedAt     TimestamptzJsDate(3)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "ComposerDraft_pkey")
  thread        Thread?              @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "ComposerDraft_threadId_idx")

  @@id([userId, scopeKey], map: "ComposerDraft_pkey")
  @@index([threadId], map: "ComposerDraft_threadId_idx")
}
