// use prisma-8
model Artifact {
  id             String               @id
  userId         String
  subdomain      String
  name           String
  currentVersion Int                  @default(0)
  createdAt      TimestamptzJsDate(3) @default(now())
  updatedAt      TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versions       ArtifactVersion[]

  @@unique([subdomain], map: "Artifact_subdomain_key")
  @@index([userId], map: "Artifact_userId_idx")
}
