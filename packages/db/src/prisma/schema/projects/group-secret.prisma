// use prisma-8
model GroupSecret {
  id          String               @id
  groupId     String
  name        String
  sealedValue String
  createdAt   TimestamptzJsDate(3) @default(now())
  updatedAt   TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  grantId     String
  group       ProjectGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "GroupSecret_groupId_name_key")
  grant       GroupAccessGrant     @relation(fields: [grantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([groupId, name], map: "GroupSecret_groupId_name_key")
  @@index([grantId])
}
