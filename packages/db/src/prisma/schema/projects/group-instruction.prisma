// use prisma-8
model GroupInstruction {
  id        String               @id @onCreate(cuid(2))
  groupId   String               @unique(map: "GroupInstruction_groupId_key")
  content   String?
  createdAt TimestamptzJsDate(3) @default(now())
  updatedAt TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  group     ProjectGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}
