// use prisma-8
model ProjectSecret {
  id          String               @id
  projectId   String
  name        String
  kind        String               @default("secret")
  sealedValue String
  createdAt   TimestamptzJsDate(3) @default(now())
  updatedAt   TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "ProjectSecret_projectId_name_key")

  @@index([projectId, name], map: "ProjectSecret_projectId_name_key", unique: true)
}
