// use prisma-8
model ProjectSecret {
  id          String               @id
  projectId   String
  name        String
  sealedValue String
  createdAt   TimestamptzJsDate(3) @default(now())
  updatedAt   TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  grantId     String?
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "ProjectSecret_projectId_name_key")
  grant       ProjectAccessGrant?  @relation(fields: [grantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([projectId, name], map: "ProjectSecret_projectId_name_key")
  @@index([grantId])
}
