// use prisma-8
model ProjectSetting {
  id        String               @id
  projectId String
  key       String
  value     String
  createdAt TimestamptzJsDate(3) @default(now())
  updatedAt TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "ProjectSetting_projectId_key_key")

  @@unique([projectId, key], map: "ProjectSetting_projectId_key_key")
}
