// use prisma-8
model GroupAccessGrant {
  id          String               @id
  groupId     String
  name        String
  instruction String               @default("")
  createdAt   TimestamptzJsDate(3) @default(now())
  updatedAt   TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  group       ProjectGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  secrets     GroupSecret[]
  fileMounts  GroupFileMount[]

  @@unique([groupId, name], map: "GroupAccessGrant_groupId_name_key")
}
