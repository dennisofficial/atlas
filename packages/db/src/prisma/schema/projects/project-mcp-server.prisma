// use prisma-8
model ProjectMcpServer {
  id         String               @id
  projectId  String
  name       String
  sealedSpec String
  createdAt  TimestamptzJsDate(3) @default(now())
  updatedAt  TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "ProjectMcpServer_projectId_name_key")

  @@index([projectId, name], map: "ProjectMcpServer_projectId_name_key", unique: true)
}
