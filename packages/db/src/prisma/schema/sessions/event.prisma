// use prisma-8
model Event {
  threadId  String
  seq       Int
  id        String                @unique
  epoch     Int
  type      String
  runId     String
  at        TimestamptzJsDate(3)
  prevHash  String
  hash      String
  canonical String
  thread    Thread              @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "V2Event_pkey")

  @@id([threadId, seq], map: "V2Event_pkey")
  @@index([threadId, type, seq], map: "V2Event_threadId_type_seq_idx")
  @@index([threadId, at], name: "Event_skill_usage", where: sql`("type" IN ('context-loaded', 'tool-called') AND (strpos("canonical", '"skill"') > 0 OR strpos("canonical", chr(92) || 'u') > 0))`)
}
