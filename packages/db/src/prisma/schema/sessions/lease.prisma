// use prisma-8
model Lease {
  sessionId    String   @id
  epoch        Int
  holderHostId Int?
  wantsHolder  Boolean  @default(false)
  attempts     Int      @default(0)
  retryAfter   TimestamptzJsDate(3)?
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([holderHostId, sessionId])
}
