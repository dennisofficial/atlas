// use prisma-8
model ContextFile {
  id        String   @id
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, index: "V2ContextFile_sessionId_idx_29f415d4")
  path      String
  digest    String?
  size      Int
  mime      String
  kind      String
  mtimeMs   Float
  updatedAt TimestamptzJsDate(3)

  @@unique([sessionId, path])
  @@index([sessionId], map: "V2ContextFile_sessionId_idx_29f415d4")
  @@index([digest], map: "V2ContextFile_digest_idx_5bd527a1")
}
