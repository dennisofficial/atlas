// use prisma-8
model Session {
  id           String                @id
  userId       String
  projectId    String?
  title             String?
  titledFromInboxId Int?
  mainThreadId String
  nextInboxId  Int
  createdAt    TimestamptzJsDate(3)
  archivedAt   TimestamptzJsDate(3)?
  deletedAt    TimestamptzJsDate(3)?
  modelRef     String
  modelEffort  String
  modelFast    Boolean
  sandboxProvider   String                @default("vercel")
  credentialSource  String                @default("platform")
  sandboxInstanceId String?
  sandboxStatus     String?
  sandboxStatusAt   TimestamptzJsDate(3)?
  sandboxStatusReason String?
  spawnedBySessionId String?
  nested             Boolean               @default(true)
  podSessionId       String?
  podRetiredAt       TimestamptzJsDate(3)?
  podDesiredVcpus    Int?
  podDesiredMemoryGb Int?
  podDesiredDiskGb   Int?
  podSizeGeneration  Int                   @default(0)
  podActualVcpus     Int?
  podActualMemoryGb  Int?
  podAppliedGeneration Int?
  podResizeError     String?
  podWaitingSince    TimestamptzJsDate(3)?
  podParkedAt        TimestamptzJsDate(3)?
  podParkError       String?
  routineId          String?
  readSeq            Int?
  lastSurface        String                @default("web")
  threads      Thread[]
  inbox        InboxEntry[]
  lease        Lease?
  view         SessionView?
  branches        SessionBranch[]
  pullRequests    SessionPullRequest[]
  worktreeChanges WorktreeChanges[]
  contextFiles    ContextFile[]
  terminals       Terminal[]
  sandboxRuns     SandboxRun[]
  diagramRepairs  DiagramRepair[]
  composerDrafts  SessionDraft[]

  @@index([mainThreadId], map: "V2Session_mainThreadId_idx_60785a54")
  @@index([userId, createdAt], map: "V2Session_userId_createdAt_idx_f726f04a")
  @@index([sandboxInstanceId], map: "V2Session_sandboxInstanceId_idx_c3850fdd")
  @@index([spawnedBySessionId, nested], map: "V2Session_spawnedBySessionId_nested_idx_c61c238d")
}
