// use prisma-8
model SessionBranch {
  sessionId    String
  headRepo     String
  branch       String
  firstSeenSeq Int
  firstSeenAt  TimestamptzJsDate(3)?
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "V2SessionBranch_pkey")

  @@id([sessionId, headRepo, branch], map: "V2SessionBranch_pkey")
  @@index([headRepo, branch], map: "V2SessionBranch_headRepo_branch_idx_2f926fb3")
}
