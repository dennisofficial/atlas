// use prisma-8
model Thread {
  id         String                @id
  sessionId  String
  headSeq    Int
  headHash   String
  visibility String
  createdAt  TimestamptzJsDate(3)
  session    Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "V2Thread_sessionId_idx")
  events     Event[]

  @@index([sessionId], map: "V2Thread_sessionId_idx")
}
