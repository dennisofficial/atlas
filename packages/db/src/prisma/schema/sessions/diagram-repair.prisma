// use prisma-8
model DiagramRepair {
  sessionId  String
  sourceHash String
  source     String
  repaired   String?
  reason     String?
  modelRef   String
  createdAt  TimestamptzJsDate(3) @default(now())
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "V2DiagramRepair_pkey")

  @@id([sessionId, sourceHash], map: "V2DiagramRepair_pkey")
}
