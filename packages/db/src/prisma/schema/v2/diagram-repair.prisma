// use prisma-8
namespace v2 {
  model V2DiagramRepair {
    sessionId  String
    sourceHash String
    source     String
    repaired   String?
    reason     String?
    modelRef   String
    createdAt  TimestamptzJsDate(3) @default(now())
    session    V2Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@id([sessionId, sourceHash])
  }
}
