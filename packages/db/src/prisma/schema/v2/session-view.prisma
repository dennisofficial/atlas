// use prisma-8
namespace v2 {
  model V2SessionView {
    sessionId String                @id
    threadId  String
    atSeq     Int
    version   Int
    state     String
    updatedAt TimestamptzJsDate(3)
    session   V2Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  }
}
