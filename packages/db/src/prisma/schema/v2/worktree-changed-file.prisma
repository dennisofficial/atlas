// use prisma-8
namespace v2 {
  model V2WorktreeChangedFile {
    checkoutId  String
    path        String
    oldPath     String?
    status      String
    additions   Int
    deletions   Int
    binary      Boolean
    baseHash    String?
    currentHash String?
    size        Int?
    changes     V2WorktreeChanges @relation(fields: [checkoutId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "V2WorktreeChangedFile_pkey")

    @@id([checkoutId, path], map: "V2WorktreeChangedFile_pkey")
    @@index([baseHash])
    @@index([currentHash])
  }
}
