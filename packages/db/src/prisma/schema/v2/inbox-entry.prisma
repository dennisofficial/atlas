// use prisma-8
namespace v2 {
  model V2InboxEntry {
    sessionId   String
    inboxId     Int
    kind        String
    payload     String
    postedAt    TimestamptzJsDate(3)
    consumedSeq Int?
    session     V2Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "V2InboxEntry_pkey")

    @@id([sessionId, inboxId], map: "V2InboxEntry_pkey")
    @@index([consumedSeq, sessionId])
  }
}
