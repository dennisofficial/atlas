// use prisma-8
namespace v2 {
  model V2RoutineRun {
    id           String                @id
    routineId    String
    scheduledFor TimestamptzJsDate(3)
    outcome      String
    reason       String?
    sessionId    String?
    at           TimestamptzJsDate(3)

    @@index([routineId, at])
  }
}
