// use prisma-8
namespace v2 {
  model V2Session {
    id           String                @id
    userId       String
    projectId    String
    title             String?
    titledFromInboxId Int?
    mainThreadId String
    nextInboxId  Int
    createdAt    TimestamptzJsDate(3)
    archivedAt   TimestamptzJsDate(3)?
    modelRef     String?
    modelEffort  String?
    modelFast    Boolean?
    spawnedBySessionId String?
    podSessionId       String?
    podRetiredAt       TimestamptzJsDate(3)?
    routineId          String?
    lastSurface        String                @default("web")
    threads      V2Thread[]
    inbox        V2InboxEntry[]
    lease        V2Lease?
    view         V2SessionView?
    pullRequests V2SessionPullRequest[]

    @@index([userId, createdAt])
  }
}
