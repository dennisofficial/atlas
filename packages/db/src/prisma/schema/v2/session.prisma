// use prisma-8
namespace v2 {
  model V2Session {
    id           String                @id
    userId       String
    projectId    String
    title        String?
    mainThreadId String
    nextInboxId  Int
    createdAt    TimestamptzJsDate(3)
    archivedAt   TimestamptzJsDate(3)?
    threads      V2Thread[]
    inbox        V2InboxEntry[]
    lease        V2Lease?

    @@index([userId, createdAt])
  }
}
