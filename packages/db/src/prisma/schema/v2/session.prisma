// use prisma-8
namespace v2 {
  model V2Session {
    id           String                @id
    userId       String
    projectId    String?
    title             String?
    titledFromInboxId Int?
    mainThreadId String
    nextInboxId  Int
    createdAt    TimestamptzJsDate(3)
    archivedAt   TimestamptzJsDate(3)?
    deletedAt    TimestamptzJsDate(3)?
    modelRef     String
    modelEffort  String
    modelFast    Boolean
    spawnedBySessionId String?
    nested             Boolean               @default(true)
    podSessionId       String?
    podRetiredAt       TimestamptzJsDate(3)?
    routineId          String?
    readSeq            Int?
    lastSurface        String                @default("web")
    threads      V2Thread[]
    inbox        V2InboxEntry[]
    lease        V2Lease?
    view         V2SessionView?
    branches        V2SessionBranch[]
    pullRequests    V2SessionPullRequest[]
    worktreeChanges V2WorktreeChanges[]
    terminals       V2Terminal[]

    @@index([userId, createdAt])
  }
}
