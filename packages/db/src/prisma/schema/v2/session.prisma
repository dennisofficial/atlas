// use prisma-8
namespace v2 {
  model V2Session {
    id           String                @id
    userId       String
    projectId    String?
    title             String?
    titledFromInboxId Int?
    mainThreadId String
    nextInboxId  Int
    createdAt    TimestamptzJsDate(3)
    archivedAt   TimestamptzJsDate(3)?
    deletedAt    TimestamptzJsDate(3)?
    modelRef     String
    modelEffort  String
    modelFast    Boolean
    sandboxProvider   String                @default("vercel")
    credentialSource  String                @default("platform")
    sandboxInstanceId String?
    sandboxStatus     String?
    sandboxStatusAt   TimestamptzJsDate(3)?
    sandboxStatusReason String?
    spawnedBySessionId String?
    nested             Boolean               @default(true)
    podSessionId       String?
    podRetiredAt       TimestamptzJsDate(3)?
    podDesiredVcpus    Int?
    podDesiredMemoryGb Int?
    podDesiredDiskGb   Int?
    podSizeGeneration  Int                   @default(0)
    podActualVcpus     Int?
    podActualMemoryGb  Int?
    podAppliedGeneration Int?
    podResizeError     String?
    podWaitingSince    TimestamptzJsDate(3)?
    routineId          String?
    readSeq            Int?
    lastSurface        String                @default("web")
    threads      V2Thread[]
    inbox        V2InboxEntry[]
    lease        V2Lease?
    view         V2SessionView?
    branches        V2SessionBranch[]
    pullRequests    V2SessionPullRequest[]
    worktreeChanges V2WorktreeChanges[]
    terminals       V2Terminal[]
    sandboxRuns     V2SandboxRun[]

    @@index([mainThreadId])
    @@index([userId, createdAt])
    @@index([sandboxInstanceId])
    @@index([spawnedBySessionId, nested])
  }
}
