// use prisma-8
namespace v2 {
  model V2ContextFile {
    id        String   @id
    sessionId String
    session   V2Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    path      String
    digest    String?
    size      Int
    mime      String
    kind      String
    mtimeMs   Float
    updatedAt TimestamptzJsDate(3)

    @@unique([sessionId, path])
    @@index([digest])
  }
}
