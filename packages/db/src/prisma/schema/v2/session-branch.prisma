// use prisma-8
namespace v2 {
  model V2SessionBranch {
    sessionId    String
    headRepo     String
    branch       String
    firstSeenSeq Int
    firstSeenAt  TimestamptzJsDate(3)?
    session      V2Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "V2SessionBranch_pkey")

    @@id([sessionId, headRepo, branch], map: "V2SessionBranch_pkey")
    @@index([headRepo, branch])
  }
}
