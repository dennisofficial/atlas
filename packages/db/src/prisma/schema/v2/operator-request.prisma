// use prisma-8
namespace v2 {
  model V2OperatorRequest {
    id         String                @id
    sessionId  String
    threadId   String
    kind       String
    prompt     String
    secret     Boolean
    shellId    String?
    status     String
    createdAt  TimestamptzJsDate(3)
    expiresAt  TimestamptzJsDate(3)
    resolvedAt TimestamptzJsDate(3)?

    @@index([sessionId])
    @@index([status, expiresAt])
  }
}
