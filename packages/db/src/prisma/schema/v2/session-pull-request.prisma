// use prisma-8
namespace v2 {
  model V2SessionPullRequest {
    sessionId    String
    repoFullName String
    prNumber     Int
    session      V2Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@id([sessionId, repoFullName, prNumber])
    @@index([repoFullName, prNumber])
  }
}
