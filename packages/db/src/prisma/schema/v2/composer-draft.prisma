// use prisma-8
namespace v2 {
  model V2ComposerDraft {
    userId      String
    scopeKey    String
    sessionId   String?
    text        String
    attachments String
    updatedAt   TimestamptzJsDate(3)
    session     V2Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@id([userId, scopeKey])
    @@index([sessionId])
  }
}
