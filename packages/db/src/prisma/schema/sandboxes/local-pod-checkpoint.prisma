// use prisma-8
model LocalPodCheckpoint {
  id         String               @id @onCreate(cuid(2))
  userId     String
  threadId   String
  checkpoint Jsonb?
  revision   Int?
  createdAt  TimestamptzJsDate(3) @default(now())
  updatedAt  TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  thread     Thread               @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([threadId], map: "LocalPodCheckpoint_threadId_key")
  @@index([userId], map: "LocalPodCheckpoint_userId_idx")
}
