// use prisma-8
model GithubPrOutbox {
  id             String               @id @onCreate(cuid(2))
  kind           String
  repoFullName   String
  prNumber       Int
  payload        Jsonb
  dedupeKey      String?              @unique
  createdAt      TimestamptzJsDate(3) @default(now())
  dispatchedAt   TimestamptzJsDate(3)?
  leaseUntil     TimestamptzJsDate(3)?
  leaseOwner     String?
  nextAttemptAt  TimestamptzJsDate(3)?
  parkedSince    TimestamptzJsDate(3)?
  deadLetteredAt TimestamptzJsDate(3)?
  attempts       Int                  @default(0)
  lastError      String?

  @@index([createdAt], name: "GithubPrOutbox_pending_idx", where: sql`("dispatchedAt" IS NULL AND "deadLetteredAt" IS NULL)`)
  @@index([parkedSince], name: "GithubPrOutbox_parked_idx", where: sql`("dispatchedAt" IS NULL AND "deadLetteredAt" IS NULL AND "parkedSince" IS NOT NULL)`)
  @@index([nextAttemptAt], name: "GithubPrOutbox_retry_idx", where: sql`("dispatchedAt" IS NULL AND "deadLetteredAt" IS NULL AND "nextAttemptAt" IS NOT NULL)`)
  @@index([dispatchedAt], name: "GithubPrOutbox_dispatched_idx", where: sql`("dispatchedAt" IS NOT NULL)`)
}
