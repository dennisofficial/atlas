// use prisma-8
model GithubAppInstallation {
  installationId BigInt                @id
  accountLogin   String
  accountType    String
  repos          String?[]?
  suspendedAt    TimestamptzJsDate(3)?
  createdAt      TimestamptzJsDate(3)  @default(now())
  updatedAt      TimestamptzJsDate(3)  @onCreate(now()) @onUpdate(now())

  @@index([accountLogin], map: "GithubAppInstallation_accountLogin_idx")
}
