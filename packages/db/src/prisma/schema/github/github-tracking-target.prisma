// use prisma-8
enum EGithubTargetKind {
  @@type("pg/text@1")
  Head        = "head"
  PullRequest = "pull-request"
}

model GithubTrackingTarget {
  id           String            @id @onCreate(cuid(2))
  userId       String
  kind         EGithubTargetKind
  repoFullName String
  branch       String            @default("")
  prNumber     Int               @default(0)
  lookedUpAt   TimestamptzJsDate(3)?
  attemptedAt  TimestamptzJsDate(3)?
  liveUntil    TimestamptzJsDate(3)
  nextDueAt    TimestamptzJsDate(3) @default(now())
  leaseUntil   TimestamptzJsDate(3)?
  leaseToken   String?
  failures     Int                  @default(0)
  createdAt    TimestamptzJsDate(3) @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "GithubTrackingTarget_userId_kind_repoFullName_branch_prNumber_key")

  @@unique([userId, kind, repoFullName, branch, prNumber], map: "GithubTrackingTarget_userId_kind_repoFullName_branch_prNumber_key")
  @@index([nextDueAt], map: "GithubTrackingTarget_nextDueAt_idx")
  @@index([liveUntil, nextDueAt], map: "GithubTrackingTarget_liveUntil_nextDueAt_idx")
  @@index([repoFullName, branch], map: "GithubTrackingTarget_repoFullName_branch_idx")
  @@index([repoFullName, prNumber], map: "GithubTrackingTarget_repoFullName_prNumber_idx")
}
