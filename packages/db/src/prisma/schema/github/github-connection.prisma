// use prisma-8

model GithubConnection {
  id          String             @id
  login       String
  scopes      String
  sealedToken String
  createdAt   TimestampString(3) @default(now())
  updatedAt   TimestampString(3) @onCreate(now()) @onUpdate(now())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "GithubConnection_userId_key", unique: true)
}
