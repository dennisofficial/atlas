// use prisma-8

model GithubPrState {
  repoFullName     String
  prNumber         Int
  title            String
  url              String
  state            String
  headBranch       String
  headSha          String
  headRepoFullName String?
  checksRunning    Int                @default(0)
  checksPassed     Int                @default(0)
  checksFailed     Int                @default(0)
  mergeable        Boolean?
  updatedAt        TimestampString(3)

  @@id([repoFullName, prNumber])
  @@index([repoFullName], map: "GithubPrState_repoFullName_idx")
}
