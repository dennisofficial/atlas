// use prisma-8
model GithubPrState {
  repoFullName     String
  prNumber         Int
  title            String
  url              String
  state            String
  headBranch       String
  headSha          String
  headRepoFullName String?
  baseBranch       String               @default("")
  pullUpdatedAt    TimestamptzJsDate(3)?
  closedAt         TimestamptzJsDate(3)?
  mergedAt         TimestamptzJsDate(3)?
  checksRunning    Int                  @default(0)
  checksPassed     Int                  @default(0)
  checksFailed     Int                  @default(0)
  checksIgnored    Int                  @default(0)
  checksExpected   Int                  @default(0)
  checksState      String?
  mergeable        Boolean?
  mergeClean       Boolean?
  mergeableHeadSha    String?
  mergeableBaseRef    String?
  mergeableObservedAt TimestamptzJsDate(3)?
  mergeQueued      Boolean              @default(false)
  autoMerge        Boolean              @default(false)
  version          Int                  @default(0)
  updatedAt        TimestamptzJsDate(3)

  @@id([repoFullName, prNumber])
  @@index([headSha])
  @@index([headRepoFullName, headBranch])
  @@index([baseBranch, state])
}
