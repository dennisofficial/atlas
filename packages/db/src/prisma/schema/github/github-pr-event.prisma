// use prisma-8
model GithubPrEvent {
  id           String                @id @onCreate(cuid(2))
  userId       String
  repoFullName String
  prNumber     Int
  kind         String
  payload      Jsonb
  dedupeKey    String?               @unique
  deliveredAt  TimestamptzJsDate(3)?
  consumedAt   TimestamptzJsDate(3)?
  createdAt    TimestamptzJsDate(3)  @default(now())
  deliveries   GithubPrEventDelivery[]
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: "GithubPrEvent_userId_deliveredAt_idx")

  @@index([userId, deliveredAt], map: "GithubPrEvent_userId_deliveredAt_idx")
  @@index([repoFullName, prNumber], map: "GithubPrEvent_repoFullName_prNumber_idx")
}
