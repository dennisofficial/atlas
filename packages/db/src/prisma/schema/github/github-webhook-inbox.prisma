// use prisma-8
model GithubWebhookInbox {
  deliveryId      String                 @id
  event           String
  payload         Jsonb?
  receivedAt      TimestamptzJsDate(3)
  processedAt     TimestamptzJsDate(3)?
  processingError String?
  attempts        Int                    @default(0)
  leaseUntil      TimestamptzJsDate(3)?
  nextAttemptAt   TimestamptzJsDate(3)?
  deadAt          TimestamptzJsDate(3)?

  @@index([receivedAt], name: "GithubWebhookInbox_due_idx", where: sql`("processedAt" IS NULL AND "deadAt" IS NULL)`)
  @@index([processedAt], name: "GithubWebhookInbox_processedAt_idx", where: sql`("processedAt" IS NOT NULL)`)
  @@index([deadAt], name: "GithubWebhookInbox_deadAt_idx", where: sql`("deadAt" IS NOT NULL)`)
}
