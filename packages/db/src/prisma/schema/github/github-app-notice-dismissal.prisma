// use prisma-8
model GithubAppNoticeDismissal {
  userId       String
  repoFullName String
  dismissedAt  TimestamptzJsDate(3) @default(now())
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

  @@id([userId, repoFullName])
}
