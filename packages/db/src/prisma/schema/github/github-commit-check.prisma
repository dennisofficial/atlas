// use prisma-8
model GithubCommitCheck {
  repoFullName    String
  headSha         String
  checkKey        String
  name            String?
  startedAt       String?
  outcome         String
  conclusion      String?
  appSlug         String?
  detailsUrl      String?
  title           String?
  summary         String?
  annotationsCount Int?
  annotations     Jsonb?
  sourceUpdatedAt TimestamptzJsDate(3)
  updatedAt       TimestamptzJsDate(3) @onCreate(now()) @onUpdate(now())

  @@id([repoFullName, headSha, checkKey])
  @@index([updatedAt])
  @@index([repoFullName, appSlug])
  @@index([repoFullName, appSlug], where: sql`(("checkKey" LIKE 'run:%') AND ("appSlug" IS NOT NULL))`, name: "GithubCommitCheck_runner_apps")
}
