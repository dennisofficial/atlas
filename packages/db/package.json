    "db:verify": "prisma db verify",
    "db:seed": "bun src/seed/cli.ts"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.19",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.15.5",
    "prisma": "8.0.0-rc.24",
    "typescript": "6.0.3"
  }
}
