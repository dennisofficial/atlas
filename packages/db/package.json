{
  "name": "@dltech/atlas-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./contract.json": "./src/prisma/schema/contract.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "db:plan": "prisma migration plan",
