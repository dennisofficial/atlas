+// Text backgrounds are drawn like CSS inline boxes: as tall as the font, not
+// the line, rounded only where the run starts and ends, and clipped to the
+// glyphs on each line. NSLayoutManager otherwise fills the whole line height
+// and extends a run that wraps to the right edge of the line.
+static const CGFloat RNUITextViewBackgroundCornerRadius = 4;
+static const CGFloat RNUITextViewBackgroundVerticalPadding = 2;
+
+@interface RNUITextViewLayoutManager : NSLayoutManager
+@end
+
+@implementation RNUITextViewLayoutManager {
+  CGPoint _backgroundOrigin;
+}
+
+- (void)drawBackgroundForGlyphRange:(NSRange)glyphsToShow atPoint:(CGPoint)origin
+{
+  _backgroundOrigin = origin;
+  [super drawBackgroundForGlyphRange:glyphsToShow atPoint:origin];
+}
+
+- (void)fillBackgroundRectArray:(const CGRect *)rectArray
+                          count:(NSUInteger)rectCount
+              forCharacterRange:(NSRange)charRange
+                          color:(UIColor *)color
+{
+  if (CGColorGetAlpha(color.CGColor) == 0) {
+    return;
+  }
+  NSTextStorage *storage = self.textStorage;
+  if (storage == nil || charRange.length == 0 || NSMaxRange(charRange) > storage.length) {
+    [super fillBackgroundRectArray:rectArray count:rectCount forCharacterRange:charRange color:color];
+    return;
+  }
+
+  NSRange runRange;
+  [storage attribute:NSBackgroundColorAttributeName
+                atIndex:charRange.location
+  longestEffectiveRange:&runRange
+                inRange:NSMakeRange(0, storage.length)];
+  const NSRange runGlyphRange = [self glyphRangeForCharacterRange:runRange actualCharacterRange:NULL];
+  const NSRange glyphRange = [self glyphRangeForCharacterRange:charRange actualCharacterRange:NULL];
+  UIFont *font = [storage attribute:NSFontAttributeName atIndex:charRange.location effectiveRange:NULL];
+  const CGFloat boxHeight = font == nil
+      ? CGFLOAT_MAX
+      : font.ascender - font.descender + 2 * RNUITextViewBackgroundVerticalPadding;
+  const CGPoint origin = _backgroundOrigin;
+
+  [color setFill];
+  [self enumerateLineFragmentsForGlyphRange:glyphRange
+                                 usingBlock:^(CGRect lineRect,
+                                              CGRect usedRect,
+                                              NSTextContainer *_Nonnull textContainer,
+                                              NSRange lineGlyphRange,
+                                              BOOL *_Nonnull stop) {
+    const NSRange piece = NSIntersectionRange(lineGlyphRange, glyphRange);
+    if (piece.length == 0) {
+      return;
+    }
+    const CGRect glyphBounds = [self boundingRectForGlyphRange:piece inTextContainer:textContainer];
+    const CGFloat minX = CGRectGetMinX(glyphBounds);
+    const CGFloat maxX = MIN(CGRectGetMaxX(glyphBounds), CGRectGetMaxX(usedRect));
+    if (maxX <= minX) {
+      return;
+    }
+    const CGFloat height = MIN(boxHeight, CGRectGetHeight(lineRect));
+    const CGRect box = CGRectMake(origin.x + minX,
+                                  origin.y + CGRectGetMidY(lineRect) - height / 2,
+                                  maxX - minX,
+                                  height);
+    UIRectCorner corners = 0;
+    if (piece.location == runGlyphRange.location) {
+      corners |= UIRectCornerTopLeft | UIRectCornerBottomLeft;
+    }
+    if (NSMaxRange(piece) == NSMaxRange(runGlyphRange)) {
+      corners |= UIRectCornerTopRight | UIRectCornerBottomRight;
+    }
+    const CGFloat radius = MIN(RNUITextViewBackgroundCornerRadius, height / 2);
+    [[UIBezierPath bezierPathWithRoundedRect:box
+                           byRoundingCorners:corners
+                                 cornerRadii:CGSizeMake(radius, radius)] fill];
+  }];
+}
+
+@end
