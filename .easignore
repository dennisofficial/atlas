# EAS uploads the repo root and reads only this file (no .gitignore) once it exists:
# https://docs.expo.dev/build-reference/easignore/

# ---- root .gitignore ----
node_modules
dist
.turbo
*.log
.DS_Store
storybook-static/

# Host-rendered workspace secret material (SSH keys, etc.) — never repo content.
.ssh/

# Per-worker git workspaces (one full-repo checkout per execute job) — see playground/src/workspace.ts
.workspaces/

# Worker engines' isolated config/state homes (CLAUDE_CONFIG_DIR / CODEX_HOME) — runtime session
# transcripts + per-engine config, never committed. See backend/src/harness/engines/engine-home.ts
.agent-home/

# Atlas durable HOST-side runtime state, kept INSIDE the repo so the working set is self-contained
# (delete the checkout → state goes with it). Holds engine homes, repo clones/worktrees, and the
# hydration sidecar. Repo-relative defaults; override via AGENT_HOME_ROOT / REPOS_ROOT /
# ATLAS_HYDRATION_STATE for a persistent volume in deployment. See backend/src/app/state-root.ts
.atlas-state/

# dotenvx — encrypted .env.*.enc files ARE committed; keys / personal / plaintext-local are NOT
.env
.env.local
.env.personal
.env.keys
!.env.*.enc

# GitHub App private key — operator-supplied secret, encrypted into backend/.env.production.enc; raw PEM never committed
backend/gh-app-private-key.pem

# Cloudflare Registrar API token — operator-supplied secret rendered to a raw path; never committed
infra/.cloudflare-registrar-token

# Prod-box SSH access — dedicated private key (ATLAS_BOX_SSH_KEY) rendered to .ssh/atlas-box; never committed
.ssh/

# Cloud / build local dirs (gcloud ADC, docker context)
/.gcloud/
/.docker/
# Slack app credentials captured at app-creation time (apps.manifest.create) — NEVER commit
backend/slack-manifests/.app-credentials.json
.playwright-cli
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# design-sync staged scripts + isolated deps (never commit)
.ds-sync/

.scratch/

# Personal per-repo instructions (ATLAS.local.md etc.) — the harness loads them, git never does
*.local.md

# The repo-local state a source launch used to keep before it was pointed at ~/.atlas like the
# shipped binary. Nothing writes here any more; the entry stays so an old checkout's secret
# material cannot be committed by accident.
.atlas-home/

# Upstream repositories cloned for reference (claude-code, opentui, skills) — read here, never vendored
.clones/

# Four reference implementations from the architecture effort. Kept out of git deliberately —
# they are evidence, not code we maintain.
.spikes/

# Build output of `bun run build` in apps/tui, and the manifest its generator emits — both are
# regenerated by the build, never committed. Named rather than the whole `bin/` directory, because
# git cannot re-include a file under an excluded directory and `bin/atlas-dev` is checked in.
apps/tui/bin/atlas
packages/harness/bin/
packages/harness/src/discovery/*.generated.ts

# The rg binary scripts/build.ts stages for `bun build --compile` to embed — per-target, never committed
packages/harness/src/execution/vendor/

# Output of `bun run build:serve` in apps/serve — regenerated, never committed
apps/serve/bin/

# Serve binary + stamps baked into the sandbox image — generated by sandbox-image.yml, never committed
apps/serve/sandbox-image/atlas-serve
apps/serve/sandbox-image/atlas-serve.version
apps/serve/sandbox-image/atlas-serve.protocol
apps/serve/sandbox-image/atlas-serve.bake-id

# Next.js build output and TS incremental state — regenerated, never committed. Their absence here
# is what let 7,847 stale files from the pre-`deprecated/` layout show up as untracked changes.
.next/
*.tsbuildinfo

.cache/

# vitest-incremental test fixtures, created and removed by its own specs
packages/vitest-incremental/.fixture/

# ---- apps/mobile/.gitignore ----
apps/mobile/node_modules/
.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
apps/mobile/npm-debug.*
apps/mobile/yarn-debug.*
apps/mobile/yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
apps/mobile/example
/apps/mobile/ios
/apps/mobile/android

# ---- not needed to build apps/mobile ----
.git
/.idea/
/.atlas/
/.github/
/deprecated/
/docs/

# Workspace members stay as package.json only, so `bun install --frozen-lockfile` still
# sees every member the lockfile names while their sources stay home.
/evals/*
!/evals/package.json
/apps/tui/*
!/apps/tui/package.json
/apps/serve/*
!/apps/serve/package.json
/apps/mac/*
!/apps/mac/package.json
/apps/web/*
!/apps/web/package.json
/apps/api/*
!/apps/api/package.json
/apps/prototype/*
!/apps/prototype/package.json
/apps/storybook/*
!/apps/storybook/package.json
/apps/webterm/*
!/apps/webterm/package.json
/packages/harness/*
!/packages/harness/package.json
/packages/db/*
!/packages/db/package.json
/packages/agent/*
!/packages/agent/package.json
/packages/control/*
!/packages/control/package.json
/packages/protocol/*
!/packages/protocol/package.json
/packages/client/*
!/packages/client/package.json
/packages/core/*
!/packages/core/package.json
/packages/models/*
!/packages/models/package.json
/packages/bun-test-shims/*
!/packages/bun-test-shims/package.json
