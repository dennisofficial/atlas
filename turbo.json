{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": ["ATLAS_HOME", "NODE_ENV", "VITEST_INCREMENTAL"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test", "^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["bin/**", "dist/**", "src/generated/**", ".next/**", "storybook-static/**"]
    }
  }
}
