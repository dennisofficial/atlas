{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!deprecated",
      "!packages/harness/skills",
      "!.agents/skills",
      "!docs/research/openai-tool-schema-optional-params.md",
      "!packages/db/.agents",
      "!packages/db/src/prisma/**/contract.d.ts",
      "!packages/db/src/prisma/**/contract.json",
      "!packages/db/migrations",
      "!**/*.generated.ts",
      "!**/*.generated",
      "!packages/harness/src/models/generated",
      "!packages/api-router/src/generated",
      "!packages/harness/src/models/generated-*.ts",
      "!packages/ui/src/styles/theme.css",
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/storybook-static"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "markdown": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single"
    },
    "linter": {
      "enabled": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noVoidTypeReturn": "off",
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off",
        "useLiteralEnumMembers": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off",
        "noRedeclare": "off",
        "noShadowRestrictedNames": "off",
        "noTemplateCurlyInString": "off",
        "noThenProperty": "off",
        "noUndeclaredEnvVars": "off",
        "noImplicitAnyLet": "off"
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["RadioGroupItem"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "a11y": "off",
          "security": "off",
          "suspicious": {
            "noDoubleEquals": "off",
            "noDocumentCookie": "off"
          },
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/tui/**"],
      "linter": {
        "rules": {
          "a11y": "off"
        }
      }
    },
    {
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noStaticOnlyClass": "off"
          },
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["**", "!**/__tests__/**", "!**/*.spec.*", "!**/*.test.*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "off"
          }
        }
      }
    },
    {
      "includes": ["**/__tests__/**", "**/*.spec.*", "**/*.test.*"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/storybook/**", "**/*.stories.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useValidAnchor": "off",
            "noStaticElementInteractions": "off"
          }
        }
      }
    }
  ]
}
