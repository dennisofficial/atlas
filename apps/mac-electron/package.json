{
  "name": "@dltech/atlas-mac-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check host-paths.js && node --check host-process.js && node --check web-payload.js",
    "bundle:payload": "bun scripts/bundle-payload.ts",
    "pack:host": "bun scripts/pack-host.ts",
    "test": "bun run bundle:payload && bun test",
    "dist:mac": "bun run bundle:payload && electron-builder --mac dmg --arm64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  }
}
