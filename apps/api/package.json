{
  "name": "@dltech/atlas-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun ./build.ts",
    "generate:trpc": "bun scripts/generate-trpc.ts",
    "dev": "bun run env:inject -- concurrently --kill-others --kill-signal SIGKILL --names api,trigger,trpc \"bun --watch src/main.ts\" \"trigger dev --profile atlas\" \"bun scripts/generate-trpc.ts --watch\"",
    "dev:no-trigger": "bun run env:inject -- bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "start:prod": "dotenvx run --strict -f envs/.env.api.$APP_TIER.enc -- bun src/main.ts",
    "env:inject": "dotenvx run -f envs/.env.api.local.enc -f envs/.env.personal --ignore=MISSING_ENV_FILE -o --strict --",
    "db:migrate": "bun run env:inject -- bun run --cwd ../../packages/db db:migrate",
    "db:plan": "bun run env:inject -- bun run --cwd ../../packages/db db:plan",
    "db:verify": "bun run env:inject -- bun run --cwd ../../packages/db db:verify",
    "db:seed": "bun run env:inject -- bun run --cwd ../../packages/db db:seed",
    "db:migrate:deploy": "dotenvx run --strict -f envs/.env.api.$MIGRATE_TIER.enc -- node scripts/migrate-deploy.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "trigger:dev": "bun run env:inject -- trigger dev --profile atlas",
    "trigger:deploy": "trigger deploy --profile atlas",
    "trigger:deploy:ci": "trigger deploy --skip-update-check",
    "trigger:smoke": "bun scripts/trigger-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@dltech/atlas-db": "workspace:*",
    "@dltech/atlas-harness": "workspace:*",
    "@dltech/atlas-wire": "workspace:*",
    "@dotenvx/dotenvx": "^1.71.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "@trigger.dev/sdk": "4.7.4",
    "@trpc/server": "^11.19.0",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "^3.10.1",
    "@vercel/sandbox": "^3.3.0",
    "ai": "^7.0.152",
    "better-auth": "^1.6.29",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.3",
    "nestjs-trpc": "^2.13.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "resend": "6.30.0",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dltech/bun-test-shims": "workspace:*",
    "@nestjs/testing": "^12.2.0",
    "@trigger.dev/build": "4.7.4",
    "@types/bun": "latest",
    "@types/express": "^5.0.3",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "concurrently": "10.0.6",
    "supertest": "^7.1.4",
    "trigger.dev": "4.7.4",
    "typescript": "6.0.3"
  }
}
