{
  "name": "@dltech/atlas-mac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check host-paths.js && node --check host-process.js && node --check web-payload.js && node --check panes.js && node --check links.js",
    "bundle:payload": "bun scripts/bundle-payload.ts",
    "pack:host": "bun scripts/pack-host.ts",
    "test": "bun run bundle:payload && bun test",
    "dist:mac": "bun run bundle:payload && bun run pack:host && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@dltech/atlas-api-router": "workspace:*",
    "@dltech/atlas-core": "workspace:*",
    "@dltech/atlas-harness": "workspace:*",
    "@dltech/atlas-wire": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dennisofficial/atlas.git"
  }
}
