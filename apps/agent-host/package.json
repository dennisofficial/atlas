{
  "name": "@dltech/atlas-agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "start": "dotenvx run --strict -f .env.production.enc -- bun src/main.ts",
    "dev": "dotenvx run --strict -f .env.local.enc -fk .env.keys -- bun --watch src/main.ts"
  },
  "dependencies": {
    "@dltech/atlas-agent": "workspace:*",
    "@dltech/atlas-api-router": "workspace:*",
    "@dltech/atlas-control": "workspace:*",
    "@dltech/atlas-core": "workspace:*",
    "@dltech/atlas-db": "workspace:*",
    "@dltech/atlas-harness": "workspace:*",
    "@dltech/atlas-host": "workspace:*",
    "@dltech/atlas-observability": "workspace:*",
    "@dltech/atlas-protocol": "workspace:*",
    "@dltech/atlas-wire": "workspace:*",
    "@dotenvx/dotenvx": "^1.71.0",
    "@vercel/sandbox": "^3.3.0",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dltech/atlas-daemon": "workspace:*",
    "@types/bun": "latest"
  }
}
