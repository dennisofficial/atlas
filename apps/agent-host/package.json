    "@ai-sdk/provider": "4.0.33",
    "@dltech/atlas-agent": "workspace:*",
    "@dltech/atlas-commands": "workspace:*",
    "@dltech/atlas-control": "workspace:*",
    "@dltech/atlas-core": "workspace:*",
    "@dltech/atlas-db": "workspace:*",
    "@dltech/atlas-host": "workspace:*",
    "@dltech/atlas-media": "workspace:*",
    "@dltech/atlas-models": "workspace:*",
    "@dltech/atlas-native-commands": "workspace:*",
    "@dltech/atlas-observability": "workspace:*",
    "@dltech/atlas-plugin-crew": "workspace:*",
    "@dltech/atlas-plugin-github": "workspace:*",
    "@dltech/atlas-plugin-memory": "workspace:*",
    "@dltech/atlas-plugin-sdk": "workspace:*",
    "@dltech/atlas-plugin-services": "workspace:*",
    "@dltech/atlas-plugin-shells": "workspace:*",
    "@dltech/atlas-protocol": "workspace:*",
    "@dotenvx/dotenvx": "^1.71.0",
    "@types/pg": "^8",
    "@vercel/sandbox": "^3.3.0",
    "ai": "^7.0.152",
    "ioredis": "^6.0.0",
    "pg": "8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dltech/atlas-client": "workspace:*",
    "@dltech/atlas-daemon": "workspace:*",
    "@types/bun": "latest"
  }
