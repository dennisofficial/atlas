{
  "name": "@dltech/atlas-agent-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "start": "bun --preload ./src/config/load-production-env.ts src/main.ts",
    "dev": "dotenvx run --strict -f .env.local.enc -fk .env.keys -- bun --watch src/main.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/gateway": "4.0.125",
    "@ai-sdk/openai": "^4.0.101",
