{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-artifacts-host",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "*.byatlas.site/*",
      "zone_name": "byatlas.site"
    }
  ],
  "vars": {
    "ARTIFACT_DOMAIN": "byatlas.site"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "atlas-artifacts"
    }
  ]
}
