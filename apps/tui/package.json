{
  "name": "@dltech/atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas \u2014 a coding-agent harness in the shape of Claude Code.",
  "type": "module",
  "bin": {
    "atlas": "./bin/atlas",
    "atlas-dev": "./bin/atlas-dev"
  },
  "scripts": {
    "dev": "bin/atlas-dev",
    "proto:shell": "bun prototype/shell.tsx",
    "proto:round2": "bun prototype/round2.tsx",
    "proto:tools": "bun prototype/tools.tsx",
    "proto:failure": "bun prototype/failure-rows.tsx",
    "proto:settings": "bun prototype/settings.tsx",
    "proto:footer": "bun prototype/footer-pills.tsx",
    "proto:attachments": "bun prototype/user-attachments.tsx",
    "proto:focus": "bun prototype/terminal-focus.tsx",
    "proto:links": "bun prototype/link-affordances.tsx",
    "probe:size": "bun scripts/probe-size.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:prepare": "bun run --filter @dltech/atlas-harness plugins:generate && bun run --filter @dltech/atlas-harness plugin-types:generate && bun scripts/generate-manifest.ts && bun scripts/generate-skills.ts",
    "build": "bun run build:prepare && bun scripts/build.ts",
    "skills:generate": "bun scripts/generate-skills.ts"
  },
  "dependencies": {
    "@dltech/atlas-api-router": "workspace:*",
    "@dltech/atlas-client": "workspace:*",
    "@dltech/atlas-commands": "workspace:*",
    "@dltech/atlas-core": "workspace:*",
    "@dltech/atlas-harness": "workspace:*",
    "@dltech/atlas-models": "workspace:*",
    "@dltech/atlas-observability": "workspace:*",
    "@dltech/atlas-plugin-crew": "workspace:*",
    "@dltech/atlas-plugin-github": "workspace:*",
    "@dltech/atlas-plugin-mcp": "workspace:*",
    "@dltech/atlas-plugin-operator": "workspace:*",
    "@dltech/atlas-plugin-sdk": "workspace:*",
    "@dltech/atlas-plugin-services": "workspace:*",
    "@dltech/atlas-plugin-sessions": "workspace:*",
    "@dltech/atlas-plugin-shells": "workspace:*",
    "@dltech/atlas-plugin-skills": "workspace:*",
    "@dltech/atlas-protocol": "workspace:*",
    "@dltech/atlas-syntax": "workspace:*",
    "@dltech/atlas-wire": "workspace:*",
    "@mariozechner/clipboard": "^0.3.9",
    "@opentui/core": "0.5.12",
    "@opentui/react": "0.5.12",
    "eventsource": "^3.0.7",
    "marked": "^18.0.7",
    "react": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "4.10.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "ai": "^7.0.180"
  }
}
