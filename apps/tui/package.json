{
  "name": "@dltech/atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas — a coding-agent harness in the shape of Claude Code.",
  "type": "module",
  "bin": {
    "atlas": "./bin/atlas",
    "atlas-dev": "./bin/atlas-dev"
  },
  "scripts": {
    "dev": "bin/atlas-dev",
    "proto:shell": "bun prototype/shell.tsx",
    "proto:round2": "bun prototype/round2.tsx",
    "proto:tools": "bun prototype/tools.tsx",
    "proto:failure": "bun prototype/failure-rows.tsx",
    "proto:settings": "bun prototype/settings.tsx",
    "proto:footer": "bun prototype/footer-pills.tsx",
    "proto:attachments": "bun prototype/user-attachments.tsx",
    "proto:focus": "bun prototype/terminal-focus.tsx",
    "probe:size": "bun scripts/probe-size.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test-shards.ts",
    "test:serial": "bun test",
    "grammars:update": "bun scripts/update-grammars.ts",
    "grammars:build-dockerfile": "bun scripts/build-dockerfile-grammar.ts",
    "build:prepare": "bun run --filter @dltech/atlas-harness plugins:generate && bun scripts/generate-manifest.ts && bun scripts/generate-skills.ts",
    "build": "bun run build:prepare && bun scripts/build.ts",
    "skills:generate": "bun scripts/generate-skills.ts"
  },
  "dependencies": {
    "@dltech/atlas-core": "workspace:*",
    "@dltech/atlas-harness": "workspace:*",
    "@mariozechner/clipboard": "^0.3.9",
    "@opentui/core": "0.5.12",
    "@opentui/react": "0.5.12",
    "marked": "^18.0.7",
    "react": "19.2.7",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "4.10.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "ai": "^7.0.92"
  }
}
