#!/usr/bin/env sh
set -eu

# Bun resolves its tsconfig from the process working directory, so a source launch has to start
# inside this workspace or it loses `emitDecoratorMetadata` and every injected constructor with it.
# The directory to work in travels as --cwd instead.
# https://bun.com/docs/runtime/typescript

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done

tui=$(cd "$(dirname "$self")/.." && pwd)
project=$PWD

cd "$tui"

quietly() {
  if ! output=$("$@" 2>&1); then
    printf '%s\n' "$output" >&2
    printf 'atlas-dev: %s failed; the launch would have read a stale manifest\n' "$*" >&2
    exit 1
  fi
}

generate() {
  if [ "${ATLAS_DEV_SKIP_GENERATE:-}" = "" ]; then
    quietly bun run --filter @dltech/atlas-harness db:ensure
    quietly bun scripts/generate-manifest.ts
    quietly bun scripts/generate-skills.ts
    quietly bun scripts/generate-plugins.ts
  fi
}

# /restart inside the TUI writes the conversation to resume into this file and exits 75; anything
# else — ctrl+c included — passes straight through.
RESTART=75

restart_file=$(mktemp "${TMPDIR:-/tmp}/atlas-dev-restart.XXXXXX")
trap 'rm -f "$restart_file"' EXIT
export ATLAS_DEV_RESTART_FILE="$restart_file"
export ATLAS_DEV=1

# Bun resolves react's development build when NODE_ENV is unset, and a profiler showed the dev
# reconciler at a quarter of a session's CPU (per-element prop diffing and Error-stack capture).
# The shipped binary is built with NODE_ENV=production; a source launch should run the same build
# it is standing in for.
export NODE_ENV=production

# Bun's runtime transpiler cache keys an entry by source hash alone — NODE_ENV is not part of the
# key — so any file over 50KB that some other command transpiled without NODE_ENV=production
# replays its `jsxDEV(...)` calls into this launch, where react/jsx-dev-runtime exports jsxDEV as
# undefined. A cache of our own only ever holds production output.
# https://bun.com/docs/runtime/modules#transpiler-cache
cache="${TMPDIR:-/tmp}/atlas-dev-transpiler-cache"
export BUN_RUNTIME_TRANSPILER_CACHE_PATH="$cache"

# The variable above is exported, so every process this session ever spawns inherits the path while
# NODE_ENV=production is easy to lose on the way down. `jsxDEV` in an entry is that leak, already
# written; the entry is keyed by source hash, so it would be replayed until the file changes again.
drop_development_transpiles() {
  [ -d "$cache" ] || return 0
  if grep -lsa jsxDEV "$cache"/*.pile >/dev/null 2>&1; then
    rm -rf "$cache"
    printf 'atlas-dev: dropped a development transpile from the cache\n' >&2
  fi
}

generate

while :; do
  code=0
  drop_development_transpiles
  bun src/main.tsx --cwd "$project" "$@" || code=$?

  if [ "$code" -ne "$RESTART" ]; then
    exit "$code"
  fi

  handle=$(cat "$restart_file")
  : > "$restart_file"

  printf 'atlas-dev: rebuilding and restarting\n' >&2
  generate

  if [ -n "$handle" ]; then
    set -- --resume "$handle"
  else
    set --
  fi
done
